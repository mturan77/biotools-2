import streamlit as st
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import io

# Sayfa Ayarları
st.set_page_config(page_title="RNA-Seq Analizi (PyDESeq2)", layout="wide")

st.title("🧬 RNA-Seq Analiz Paneli (Python versiyonu)")
st.markdown("R DESeq2 mantığının Python (PyDESeq2) ve Streamlit ile uyarlanmış halidir.")

# --- 1. SIDEBAR: Dosya Yükleme ve Ayarlar ---
with st.sidebar:
    st.header("1. Veri Yükleme")
    file_counts = st.file_uploader("Counts Matrix (CSV)", type=["csv"])
    file_samples = st.file_uploader("Metadata / Samples (CSV)", type=["csv"])
    file_genes = st.file_uploader("Gen Listesi (TXT - Opsiyonel)", type=["txt"])
    
    st.divider()
    st.header("2. Parametreler")
    padj_cut = st.number_input("P-adj Cutoff", 0.0, 1.0, 0.05, 0.01)
    lfc_cut = st.number_input("Log2 Fold Change Cutoff", 0.0, 10.0, 1.0, 0.5)
    min_count = st.number_input("Min Count Filtresi (Row Sum)", 0, 100, 10)
    
    btn_run = st.button("Analizi Başlat", type="primary")

# --- Fonksiyonlar ---

@st.cache_resource
def run_deseq_fit(counts_df, metadata_df, design_col):
    """
    DESeq2 modelini kurar ve fit eder (Zaman aldığı için cache'liyoruz)
    """
    # PyDESeq2 formatı: Samples (Satır) x Genes (Sütun) ister.
    # R genelde Genes x Samples verir. O yüzden transpose (.T) gerekebilir.
    
    # Kontrol: Eğer sütun isimleri metadata index'i ile eşleşiyorsa transpose al
    if set(counts_df.columns) == set(metadata_df.index):
        counts_df = counts_df.T
    
    # Eksik verileri doldur
    counts_df = counts_df.fillna(0).astype(int)
    
    # Filtreleme (R'daki rowSums >= 10 mantığı)
    # PyDESeq2'de genler sütun olduğu için sütun toplamına bakıyoruz
    genes_to_keep = counts_df.columns[counts_df.sum(axis=0) >= min_count]
    counts_df = counts_df[genes_to_keep]

    inference = DeseqDataSet(
        counts=counts_df,
        metadata=metadata_df,
        design_factors=design_col,
        quiet=True
    )
    
    inference.deseq2() # Modeli çalıştır
    return inference

def run_deseq_result(dds, contrast):
    """
    İstatistiksel testi çalıştırır
    """
    stat_res = DeseqStats(dds, contrast=contrast, quiet=True)
    stat_res.summary()
    return stat_res.results_df

# --- ANA AKIŞ ---

if btn_run and file_counts and file_samples:
    
    # 1. Veri Okuma
    try:
        counts_data = pd.read_csv(file_counts, index_col=0)
        samples_data = pd.read_csv(file_samples, index_col=0)
        
        # Metadata içindeki condition sütununu bul (ilk sütun varsayıyoruz yoksa 'condition' arıyoruz)
        design_col = "condition"
        if "condition" not in samples_data.columns:
            st.warning("'condition' sütunu bulunamadı, ilk sütun kullanılıyor.")
            design_col = samples_data.columns[0]
        
        # String'e çevir (Kategorik olması için)
        samples_data[design_col] = samples_data[design_col].astype(str)
        
        st.success("✅ Veriler yüklendi, analiz başlıyor...")
        
        # 2. DESeq2 Fit (Model Kurma)
        with st.spinner('DESeq2 Normalizasyonu ve Dispersiyon hesabı yapılıyor... (Bu biraz sürebilir)'):
            dds = run_deseq_fit(counts_data, samples_data, design_col)
            
            # Normalize countları al (PCA ve Heatmap için)
            # PyDESeq2'de normalize edilmiş countlara erişim:
            norm_counts = dds.layers['log1norm'] # Log normalize (VST benzeri pratik kullanım)
            # Eğer direkt norm counts lazımsa: dds.layers['normed_counts']
            
        st.info("Model oluşturuldu. Sekmelerden sonuçları inceleyin.")
        
        # 3. Sekmeler
        tab1, tab2, tab3 = st.tabs(["📊 PCA & Genel", "🌋 Volcano & Tablo", "🔥 Heatmaps"])
        
        # --- TAB 1: PCA ---
        with tab1:
            st.subheader("PCA Analizi")
            
            # PCA Hesapla
            pca = PCA(n_components=2)
            # norm_counts: Samples x Genes
            pca_res = pca.fit_transform(norm_counts)
            var_exp = pca.explained_variance_ratio_ * 100
            
            pca_df = pd.DataFrame(pca_res, columns=["PC1", "PC2"], index=norm_counts.index)
            pca_df['Condition'] = samples_data[design_col]
            
            # Çizim
            fig_pca, ax = plt.subplots(figsize=(8, 6))
            sns.scatterplot(data=pca_df, x="PC1", y="PC2", hue="Condition", s=100, ax=ax)
            ax.set_xlabel(f"PC1 ({var_exp[0]:.1f}%)")
            ax.set_ylabel(f"PC2 ({var_exp[1]:.1f}%)")
            ax.set_title("PCA Plot")
            st.pyplot(fig_pca)
            
        # --- TAB 2: Karşılaştırma ve Volcano ---
        with tab2:
            st.subheader("Diferansiyel İfade Analizi")
            
            groups = samples_data[design_col].unique()
            col1, col2 = st.columns(2)
            with col1:
                group_a = st.selectbox("Grup 1 (Test)", groups)
            with col2:
                group_b = st.selectbox("Grup 2 (Referans)", [g for g in groups if g != group_a])
                
            if st.button("Karşılaştır"):
                with st.spinner("İstatistiksel test yapılıyor..."):
                    contrast = [design_col, group_a, group_b]
                    res_df = run_deseq_result(dds, contrast)
                    
                    # Yorumlama Sütunu Ekle
                    res_df['Color'] = 'Not Sig'
                    res_df.loc[(res_df['log2FoldChange'] > lfc_cut) & (res_df['padj'] < padj_cut), 'Color'] = 'UP'
                    res_df.loc[(res_df['log2FoldChange'] < -lfc_cut) & (res_df['padj'] < padj_cut), 'Color'] = 'DOWN'
                    
                    # Volcano Plot
                    fig_vol, ax = plt.subplots(figsize=(8, 6))
                    colors = {'UP': 'blue', 'DOWN': 'red', 'Not Sig': 'grey'}
                    
                    # Eksik değerleri temizle (plot hatası olmasın)
                    plot_df = res_df.dropna(subset=['log2FoldChange', 'padj']).copy()
                    
                    sns.scatterplot(data=plot_df, x='log2FoldChange', y=-np.log10(plot_df['padj']), 
                                    hue='Color', palette=colors, alpha=0.7, ax=ax)
                    
                    ax.axvline(x=lfc_cut, linestyle="--", color="black", alpha=0.5)
                    ax.axvline(x=-lfc_cut, linestyle="--", color="black", alpha=0.5)
                    ax.axhline(y=-np.log10(padj_cut), linestyle="--", color="black", alpha=0.5)
                    ax.set_title(f"Volcano: {group_a} vs {group_b}")
                    st.pyplot(fig_vol)
                    
                    # Sonuç Tablosu
                    st.dataframe(res_df.sort_values("padj").head(50))
                    
                    # İndirme Butonu
                    csv = res_df.to_csv().encode('utf-8')
                    st.download_button("Sonuçları İndir (CSV)", csv, f"Deseq2_{group_a}_vs_{group_b}.csv", "text/csv")

        # --- TAB 3: Heatmap ---
        with tab3:
            st.subheader("Heatmap Görünümü")
            
            heatmap_mode = st.radio("Mod:", ["En Çok Değişenler (Top 50)", "Özel Gen Listesi"])
            
            # Veriyi hazırla (Transpoze alarak Genes x Samples yapıyoruz ki Seaborn clustermap güzel görünsün)
            # norm_counts: Samples x Genes -> Transpose -> Genes x Samples
            plot_matrix = norm_counts.T
            
            genes_to_plot = []
            
            if heatmap_mode == "En Çok Değişenler (Top 50)":
                # Varyansa göre sırala
                variances = plot_matrix.var(axis=1)
                genes_to_plot = variances.sort_values(ascending=False).head(50).index
                
            elif heatmap_mode == "Özel Gen Listesi" and file_genes:
                # Dosyadan oku
                file_genes.seek(0)
                target_genes = [line.decode("utf-8").strip() for line in file_genes]
                # Veride var mı kontrol et
                genes_to_plot = [g for g in target_genes if g in plot_matrix.index]
                if not genes_to_plot:
                    st.error("Listedeki genler veride bulunamadı!")
            
            if len(genes_to_plot) > 1:
                final_mat = plot_matrix.loc[genes_to_plot]
                
                # Z-score (scale="row" mantığı)
                # Seaborn clustermap z_score parametresi alır (0 = rows, 1 = columns)
                # Verimiz Genes x Samples olduğu için z_score=0 diyemeyiz, çünkü heatmap çizilirken scale işlemi yapılır.
                # Seaborn'da 'z_score=0' satırlar (genler) üzerinde normalizasyon yapar.
                
                # Renk paleti
                cmap = sns.diverging_palette(240, 10, as_cmap=True) # Mavi - Kırmızı
                
                # Metadata annotation (Sütunlar için renkler)
                # Bu kısım seaborn'da biraz manueldir, basitlik için direkt çiziyoruz.
                
                fig_heat = sns.clustermap(final_mat, 
                                          z_score=0, # Satır bazlı normalizasyon (R scale='row')
                                          cmap=cmap, 
                                          center=0,
                                          col_cluster=False, # Gruplar karışmasın
                                          figsize=(8, 10))
                
                st.pyplot(fig_heat)
            else:
                st.warning("Çizilecek yeterli gen yok.")
                
    except Exception as e:
        st.error(f"Bir hata oluştu: {e}")

else:
    st.info("Lütfen sol menüden Counts ve Samples dosyalarını yükleyip 'Analizi Başlat'a basın.")
